<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wails-crafting-apps-hub.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Crafting Apps\Crafting Apps Hub">
    </Installer>
    <PackageInformation
        PackageName="Crafting Apps Hub"
        PackageDisplayName="Crafting Apps Hub"
        PublisherName="CN=Crafting Apps"
        PublisherDisplayName="Crafting Apps"
        Version="0.2.0.0"
        PackageDescription="A wails-crafting-apps-hub application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.craftingapps.hub"
                Description="A wails-crafting-apps-hub application"
                DisplayName="Crafting Apps Hub"
                ExecutableName="wails-crafting-apps-hub.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Crafting Apps Hub</DisplayName>
            <PublisherDisplayName>Crafting Apps</PublisherDisplayName>
            <Description>A wails-crafting-apps-hub application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wails-crafting-apps-hub.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
